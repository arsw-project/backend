# DRIZZLE_DATABASE_URL: Connection string for the PostgreSQL database used by Drizzle ORM.
#   Example: "postgresql://username:password@host:port/database"
#
# GOOGLE_CLIENT_ID: OAuth 2.0 Client ID for Google authentication.
#   Example: "your-google-client-id.apps.googleusercontent.com"
#
# GOOGLE_CLIENT_SECRET: OAuth 2.0 Client Secret for Google authentication.
#   Example: "your-google-client-secret"
#
# GOOGLE_LOGIN_REDIRECT: Redirect URI for Google OAuth login flow.
#   Example: "http://localhost:5173"
#
# CORS_ORIGIN: Comma-separated list of allowed CORS origins.
#   Example: "http://localhost:5173,http://localhost:3000"
#
# HOST: Host and port where the backend server will run.
#   Example: "http://localhost:3000"
#
# LOGGING_CONSOLE_ENABLED: Enable or disable console logging.
#   Example: "true" or "false"
#
# LOGGING_FILE_ENABLED: Enable or disable file logging.
#   Example: "true" or "false"
#
# LOGGING_FILE_FOLDER: File path for storing log files.
#   Example: "logs/app.log"
# 
# LOGGING_EXTERNAL_ENABLED: Enable or disable external logging.
#   Example: "true" or "false"
#
# LOGGING_EXTERNAL_URL: URL of the external logging service.
#   Example: "http://external-logging-service.com/api/logs"
#
# SERVICE_SECRET_KEY: Secret key for service-to-service authentication.
#   Used by microservices to access internal endpoints.
#   Example: "your-secret-service-key"
#
# SYSTEM_USER_EMAIL: Email address for the system administrator user.
#   This user is created automatically on application startup.
#   Example: "root@mail.com"
#
# SYSTEM_USER_PASSWORD: Password for the system administrator user.
#   Example: "your-system-password"
#
# SYSTEM_USER_NAME: Name for the system administrator user.
#   Example: "System"
DRIZZLE_DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_LOGIN_REDIRECT=
CORS_ORIGIN=http://localhost:5173
HOST=
LOGGING_CONSOLE_ENABLED=true
LOGGING_FILE_ENABLED=true
LOGGING_FILE_FOLDER=logs
LOGGING_EXTERNAL_ENABLED=false
LOGGING_EXTERNAL_URL=
SERVICE_SECRET_KEY=
SYSTEM_USER_EMAIL=
SYSTEM_USER_PASSWORD=
SYSTEM_USER_NAME=