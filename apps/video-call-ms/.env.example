# Video Call Microservice Environment Variables

# Server
PORT=3002

# Monolith URL for validation
MONOLITH_URL=http://localhost:3000

# Tickets Microservice URL
TICKETS_MS_URL=http://localhost:3001

# Service secret for internal API calls
SERVICE_SECRET_KEY=super-secret-service-key-2024

# Database
DRIZZLE_DATABASE_URL=postgresql://postgres:postgres@localhost:15432/video_call_db

# Room inactivity timeout in minutes (default: 30)
ROOM_INACTIVITY_TIMEOUT_MINUTES=30