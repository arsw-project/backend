{
	"$schema": "https://json.schemastore.org/nest-cli",
	"collection": "@nestjs/schematics",
	"projects": {
		"backend": {
			"type": "application",
			"root": "src",
			"entryFile": "main",
			"sourceRoot": "src",
			"compilerOptions": {
				"tsConfigPath": "tsconfig.build.json"
			}
		}
	},
	"compilerOptions": {
		"deleteOutDir": true
	}
}
